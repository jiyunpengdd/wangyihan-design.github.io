---
import { Image } from 'astro:assets';
import portrait from '@/assets/images/han-portrait.webp';
import Icon from '@/components/ui/Icon.astro';
import { about } from '@/config/about';
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profileSchema } from '@/lib/schema';
import WarpText from '@/components/ui/WarpText.astro';
---

<BaseLayout
  title="关于"
  description={`关于 ${siteConfig.author.name}，一位常驻${siteConfig.author.location}的${siteConfig.author.role}，专注于用户需求洞察、跨端产品体验和 AI 辅助产品。`}
  type="profile"
  structuredData={profileSchema('/about/')}
>
  <header class="shell grid gap-12 pt-16 sm:pt-24 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end lg:gap-16">
    <div>
      <p class="rise eyebrow">{about.eyebrow}</p>
      <WarpText class="rise mt-6 text-headline" style="--rise-step: 1" text={about.title} highlight={about.highlight} />
      <p class="rise mt-6 max-w-2xl text-lead text-body" style="--rise-step: 2">
        {about.text}
      </p>
      <div class="rise mt-8 flex flex-wrap gap-3" style="--rise-step: 3">
        <a class="btn btn-primary" href="/resume/">
          查看简历
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </a>
        <a class="btn btn-ghost" href={`mailto:${siteConfig.author.email}`}>
          给我发邮件
        </a>
      </div>
    </div>
    <div class="rise relative" style="--rise-step: 2">
      <Image
        src={portrait}
        alt={about.portraitAlt}
        widths={[320, 480, 640]}
        sizes="(min-width: 64rem) 22rem, 90vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-4/5 w-full rounded-card object-cover object-top"
      />
      <p class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full bg-surface/90 px-3.5 py-1.5 text-sm font-medium backdrop-blur">
        <Icon name="map-pin" class="size-3.5" />
        {siteConfig.author.location}
      </p>
    </div>
  </header>

  <div class="shell mt-20 sm:mt-28">
    {about.sections.map((section) => (
      <section class="reveal grid gap-6 border-t border-line py-12 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-16">
        <h2 class="eyebrow self-start">{section.title}</h2>
        <div class="grid max-w-3xl gap-5 text-lead text-body">
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>
    ))}
  </div>

  <section class="shell mt-16 sm:mt-24" aria-labelledby="principles-title">
    <h2 id="principles-title" class="reveal text-section">
      {about.principles.title}
    </h2>
    <ol class="principle-grid mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {about.principles.items.map((item, index) => (
        <li
          class="principle-card reveal rounded-card border border-line bg-surface p-7"
          style={`--rise-step: ${index + 1}`}
        >
          <span class="font-serif text-3xl text-muted italic" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-8 text-title">{item.title}</h3>
          <p class="mt-3 text-muted">{item.text}</p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .principle-card {
    --rotate-x: 0deg;
    --rotate-y: 0deg;
    --card-scale: 1;
    --spot-x: 50%;
    --spot-y: 40%;
    --spotlight: var(--accent);
    position: relative;
    isolation: isolate;
    transform: perspective(900px) rotateX(var(--rotate-x)) rotateY(var(--rotate-y)) scale(var(--card-scale));
    transition:
      transform 180ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 180ms ease,
      filter 180ms ease,
      opacity 180ms ease,
      box-shadow 180ms ease;
    will-change: transform;
  }

  :root .principle-card {
    --spot-max-opacity: 0.24;
    --edge-max-opacity: 0.64;
  }

  :root.dark .principle-card {
    --spotlight: color-mix(in oklab, var(--accent) 62%, white);
    --spot-max-opacity: 0.38;
    --edge-max-opacity: 1;
  }

  .principle-card > :global(*) {
    position: relative;
    z-index: 1;
  }

  .principle-card::before,
  .principle-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .principle-card::before {
    background: radial-gradient(
      circle 260px at var(--spot-x) var(--spot-y),
      color-mix(in oklab, var(--spotlight) 48%, transparent),
      transparent 74%
    );
  }

  .principle-card::after {
    padding: 1px;
    background: radial-gradient(
      circle 220px at var(--spot-x) var(--spot-y),
      color-mix(in oklab, var(--spotlight) 72%, transparent),
      transparent 74%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
  }

  @media (hover: hover) and (pointer: fine) {
    .principle-card:hover {
      --card-scale: 1.035;
      border-color: color-mix(in oklab, var(--line-strong) 72%, var(--ink));
      box-shadow: var(--shadow-shot);
      z-index: 1;
    }

    .principle-card:hover::before {
      opacity: var(--spot-max-opacity);
    }

    .principle-card:hover::after {
      opacity: var(--edge-max-opacity);
    }

    .principle-grid:has(.principle-card:hover) .principle-card:not(:hover) {
      --card-scale: 0.97;
      filter: brightness(0.96);
      opacity: 0.82;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .principle-card {
      transform: none;
      transition: none;
      will-change: auto;
    }

    .principle-card::before,
    .principle-card::after {
      transition: none;
    }
  }
</style>

<script>
  const grid = document.querySelector('.principle-grid');

  if (grid) {
    const resetTilt = (card: HTMLElement) => {
      card.style.setProperty('--rotate-x', '0deg');
      card.style.setProperty('--rotate-y', '0deg');
    };

    grid.addEventListener('pointermove', (event) => {
      const pointerEvent = event as PointerEvent;
      if (pointerEvent.pointerType !== 'mouse') return;

      const card = event.target instanceof Element ? event.target.closest<HTMLElement>('.principle-card') : null;
      if (!card) return;

      const { left, top, width, height } = card.getBoundingClientRect();
      const pointerX = (pointerEvent.clientX - left) / width - 0.5;
      const pointerY = (pointerEvent.clientY - top) / height - 0.5;
      const spotX = pointerEvent.clientX - left;
      const spotY = pointerEvent.clientY - top;

      card.style.setProperty('--rotate-x', `${pointerY * -8}deg`);
      card.style.setProperty('--rotate-y', `${pointerX * 8}deg`);
      card.style.setProperty('--spot-x', `${spotX}px`);
      card.style.setProperty('--spot-y', `${spotY}px`);
    });

    grid.addEventListener('pointerleave', () => {
      grid.querySelectorAll<HTMLElement>('.principle-card').forEach(resetTilt);
    });
  }
</script>
